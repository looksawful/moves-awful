{
  "name": "moves-awful",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "node --check canvas-animations/arc.js && node --check canvas-animations/spiral.js && node --check scripts/install-vendor-skills.mjs && node --check scripts/check-tests.mjs && node --check scripts/check-workflow-policy.mjs && node scripts/check-tests.mjs && node scripts/check-workflow-policy.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "skills:list": "node scripts/install-vendor-skills.mjs --list",
    "skills:install": "node scripts/install-vendor-skills.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  }
}
